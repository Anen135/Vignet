{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vignet.local/schemas/asset-v1.json",
  "title": "Vignet AssetDefinition v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "description",
    "styles",
    "media",
    "actions",
    "settingsSchema",
    "permissions",
    "execution",
    "defaultScope",
    "compatibility"
  ],
  "anyOf": [{ "required": ["entry"] }, { "required": ["scripts"] }],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "description": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "author": { "type": "string" },
    "license": { "type": "string" },
    "entry": { "$ref": "#/definitions/path" },
    "scripts": { "$ref": "#/definitions/paths" },
    "styles": { "$ref": "#/definitions/paths" },
    "media": { "$ref": "#/definitions/paths" },
    "actions": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 32,
      "propertyNames": { "pattern": "^[a-z][a-zA-Z0-9_]*$" },
      "additionalProperties": {
        "type": "object",
        "required": ["description", "parameters"],
        "additionalProperties": false,
        "properties": {
          "description": { "type": "string", "minLength": 1 },
          "parameters": { "$ref": "#/definitions/parameterSchema" }
        }
      }
    },
    "settingsSchema": { "$ref": "#/definitions/parameterSchema" },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["dom_overlay", "dom_access", "audio", "user_scripts"]
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "world": { "const": "USER_SCRIPT", "default": "USER_SCRIPT" },
        "multipleInstances": { "type": "boolean", "default": false },
        "cleanupGuarantee": {
          "enum": ["managed", "best-effort"],
          "default": "best-effort"
        },
        "requiresReloadOnStop": { "type": "boolean", "default": false }
      }
    },
    "defaultScope": { "enum": ["global", "chat", "temporary"] },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimumChromeVersion": { "type": "integer", "minimum": 116 }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
    }
  },
  "definitions": {
    "path": {
      "type": "string",
      "maxLength": 239,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[a-zA-Z0-9_-]+(?:[./-][a-zA-Z0-9_-]+)*$"
    },
    "paths": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/path" }
    },
    "parameterSchema": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "object",
            "array",
            "string",
            "number",
            "integer",
            "boolean",
            "null"
          ]
        },
        "properties": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/parameterSchema" }
        },
        "required": { "type": "array", "items": { "type": "string" } },
        "additionalProperties": { "type": "boolean" },
        "items": { "$ref": "#/definitions/parameterSchema" },
        "enum": { "type": "array", "minItems": 1 },
        "default": {},
        "title": { "type": "string" },
        "description": { "type": "string" },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "minLength": { "type": "integer", "minimum": 0 },
        "maxLength": { "type": "integer", "minimum": 0 },
        "pattern": { "const": "^#[a-fA-F0-9]{6}$" },
        "minItems": { "type": "integer", "minimum": 0 },
        "maxItems": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
