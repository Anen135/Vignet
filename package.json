{
  "name": "chatgpt-vignette-mvp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Minimal MCP Bridge and Chrome extension to control a ChatGPT vignette",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "menu": "node scripts/setup.mjs",
    "start": "node bridge/server.mjs",
    "start:http": "node bridge/http.mjs",
    "start:private": "node scripts/start-private.mjs",
    "start:cloudflare": "node scripts/cloudflare.mjs",
    "start:ngrok": "node scripts/cloudflare.mjs --ngrok",
    "test:browser": "npm run build && node tests/browser.e2e.mjs",
    "test": "node tests/smoke.mjs && node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "build": "node scripts/build.mjs",
    "pack:asset": "node scripts/pack-asset.mjs",
    "format": "prettier --write \"bridge/**/*.mjs\" \"extension/**/*.{js,json,html,css}\" \"scripts/*.mjs\" \"tests/*.test.mjs\" \"tests/smoke.mjs\" \"packages/**/*.{js,json,css}\" \"schemas/*.json\" package.json"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "css-tree": "^3.2.1",
    "fflate": "^0.8.3",
    "ws": "^8.18.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10"
  }
}
